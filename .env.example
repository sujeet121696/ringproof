# Ringproof settings. Copy to .env and fill in. Never commit .env.

# --- Brain (risk engine) ---
# nebius = Nemotron on Nebius Token Factory (real, costs credit)
# mock   = simple keyword rules, no API calls (free, for UI work)
PROVIDER=nebius

# --- Nebius Token Factory (https://tokenfactory.nebius.com) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Main model, and the backup used if it fails or is slow
REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# Seconds to wait for a model reply before using the backup
MODEL_TIMEOUT_S=30

# --- Tavily (official helpline lookup, https://app.tavily.com) ---
TAVILY_API_KEY=

# --- Email: trusted-contact alert + "Is this you?" check (same setup as Resolve) ---
# Gmail: turn on 2-Step Verification, then create an app password (Google Account > Security).
# Leave SMTP_USER empty to run without email (the screen then says the email was not sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Demo family emails are @example.com (no inbox). Send them to this real inbox instead.
EMAIL_DEMO_REDIRECT_TO=
# Emails are sent ONLY to the redirect inbox above and to these addresses (comma-separated).
# Anything else is refused, so the public demo can't email strangers from your account.
EMAIL_ALLOWED_TO=
# Base of the links inside emails. Local: the dashboard. Deployed: https://ringproof.kharidwise.com
PUBLIC_BASE_URL=http://localhost:5180

# Live calls at once (each one uses model credits).
MAX_LIVE_CALLS=3
# Recordings one visitor may upload per hour (each one uses the GPU).
UPLOADS_PER_HOUR=10

# --- Speech service: Parakeet + Sortformer on a Nebius GPU (asr/README.md) ---
# Empty = off (uploads say transcription is not switched on; samples replay their scripts).
# With the SSH tunnel from asr/README.md: http://127.0.0.1:9000
ASR_URL=
# Long random string; the same value as ASR_TOKEN on the GPU VM.
ASR_TOKEN=

# --- Vobiz phone line (a call to the number is transcribed live onto the waiting dashboard) ---
# Long random string (letters and digits). Empty = the line is off.
# In the Vobiz application set the Answer URL to: <PUBLIC_BASE_URL>/vobiz/answer/<VOBIZ_SECRET>
VOBIZ_SECRET=
# The Vobiz number, shown on the dashboard while it waits, e.g. +91...
VOBIZ_NUMBER=
